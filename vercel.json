{
  "buildCommand": "echo 'static site - no build needed'",
  "outputDirectory": "site",
  "framework": null,
  "installCommand": "echo 'no install'",
  "devCommand": "python3 -m http.server 3000 -d site",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"X-Frame-Options","value":"DENY"},
        {"key":"Referrer-Policy","value":"no-referrer"},
        {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=(), payment=()"},
        {"key":"Content-Security-Policy","value":"default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"}
      ]
    }
  ]
}
