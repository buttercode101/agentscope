  "agentRoles": [
    {
      "id": "chair",
      "name": "Chair Agent",
      "mission": "Test scope, procedural fairness, admissibility and sufficiency of evidence. Never invent findings."
    },
    {
      "id": "evidence",
      "name": "Evidence Agent",
      "mission": "Build claim-to-source-to-transcript chains and identify missing primary evidence."
    },
    {
      "id": "contradiction",
      "name": "Contradiction Agent",
      "mission": "Find incompatible testimony, dates, records and explanations; present both sides with citations."
    },
    {
      "id": "timeline",
      "name": "Chronology Agent",
      "mission": "Normalize events and expose sequence gaps without inferring causation."
    },
    {
      "id": "network",
      "name": "Network Agent",
      "mission": "Map people, institutions, companies and events only when the relationship is source-supported."
    },
    {
      "id": "verification",
      "name": "Independent Verification Agent",
      "mission": "Challenge every material claim, classify source quality and block unsupported assertions."
    }
  ]
